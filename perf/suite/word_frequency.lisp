;;;; Count token frequencies, bucket values, and reduce top bucket summaries.

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(defparameter *name* "word_frequency")
(defparameter *description* "Dictionary frequency counting and bucketed list reduction")
(defparameter *default-size* 80000)
(defparameter *default-seed* 42)

(defparameter *vocab*
  #("alpha" "beta" "gamma" "delta"
    "epsilon" "zeta" "eta" "theta"
    "iota" "kappa" "lambda" "mu"
    "nu" "xi" "omicron" "pi"))

(defun prepare (size seed)
  (declare (type fixnum size seed))
  (when (< size 0)
    (error "size must be nonnegative"))
  (let ((state (logand seed #x7FFFFFFF))
        (items (make-array size))
        (vocab *vocab*))
    (declare (type fixnum state)
             (type simple-vector items vocab))
    (dotimes (i size items)
      (declare (type fixnum i))
      (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
      (let ((word (the simple-string (svref vocab (logand (ash state -5) 15))))
            (suffix (write-to-string (mod (ash state -12) 32)))
            (weight (+ (- (mod (ash state -18) 97) 30) (logand i 7))))
        (setf (svref items i)
              (cons (concatenate 'string word "_" suffix) weight))))))

(defun run-kernel (data)
  (declare (type simple-vector data))
  (let* ((counts (make-hash-table :test 'equal))
         (totals (make-hash-table :test 'equal))
         (n (length data))
         (rounds (max 1 (floor n 198)))
         (bucket-sum 0))
    (declare (type fixnum n rounds bucket-sum))
    (dotimes (round-idx rounds)
      (declare (type fixnum round-idx))
      (let ((bias (- (logand round-idx 7) 3))
            (positive-weights (make-array 64 :adjustable t :fill-pointer 0)))
        (declare (type fixnum bias))
        (dotimes (i n)
          (declare (type fixnum i))
          (let* ((item (svref data i))
                 (token (the simple-string (car item)))
                 (weight (the fixnum (cdr item)))
                 (adj (the fixnum (+ weight bias))))
            (declare (type fixnum weight adj))
            (setf (gethash token counts)
                  (the fixnum (+ (the fixnum (gethash token counts 0)) 1)))
            (setf (gethash token totals)
                  (the fixnum (+ (the fixnum (gethash token totals 0)) adj)))
            (when (> adj 0)
              (vector-push-extend adj positive-weights))))
        (let ((filtered (make-array 64 :adjustable t :fill-pointer 0))
              (m (length positive-weights)))
          (declare (type fixnum m))
          (dotimes (j m)
            (declare (type fixnum j))
            (let ((w (the fixnum (aref positive-weights j))))
              (when (= (logand w 1) 1)
                (vector-push-extend (the fixnum (+ (the fixnum (* w 3)) 1)) filtered))))
          (let ((k (length filtered)))
            (declare (type fixnum k))
            (dotimes (j k)
              (declare (type fixnum j))
              (setf bucket-sum
                    (logand (the fixnum (+ bucket-sum (the fixnum (aref filtered j))))
                            #x3FFFFFFF)))))))
    (let ((freq-checksum 0)
          (distinct 0))
      (declare (type fixnum freq-checksum distinct))
      (maphash (lambda (token count)
                 (declare (type simple-string token)
                          (type fixnum count))
                 (incf distinct)
                 (setf freq-checksum
                       (logand (the fixnum (+ freq-checksum
                                              (the fixnum (* count 17))
                                              (the fixnum (gethash token totals 0))
                                              (length token)))
                               #x3FFFFFFF)))
               counts)
      (list distinct freq-checksum bucket-sum))))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
