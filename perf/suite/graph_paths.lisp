;;;; Dijkstra traversal of a seeded, connected sparse graph.

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(defparameter *name* "graph_paths")
(defparameter *description* "Sparse-graph Dijkstra traversal with heap operations")
(defparameter *default-size* 20000)
(defparameter *default-seed* 42)

(defun prepare (size seed)
  (declare (type fixnum size seed))
  (when (< size 1)
    (error "size must be positive"))
  (let ((adj (make-array size))
        (state (logand seed #x7FFFFFFF)))
    (declare (type simple-vector adj)
             (type fixnum state))
    (dotimes (i size)
      (setf (svref adj i) (make-array 4 :adjustable t :fill-pointer 0)))
    (dotimes (vertex (- size 1))
      (declare (type fixnum vertex))
      (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
      (let ((weight (+ (mod (ash state -16) 97) 1)))
        (vector-push-extend (cons (+ vertex 1) weight) (svref adj vertex))
        (vector-push-extend (cons vertex weight) (svref adj (+ vertex 1)))))
    (dotimes (vertex size adj)
      (declare (type fixnum vertex))
      (dotimes (k 3)
        (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
        (let ((target (mod (ash state -8) size)))
          (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
          (let ((weight (+ (mod (ash state -16) 97) 1)))
            (unless (= target vertex)
              (vector-push-extend (cons target weight) (svref adj vertex))
              (vector-push-extend (cons vertex weight) (svref adj target)))))))))

(declaim (inline heap-less-p))
(defun heap-less-p (a b)
  (let ((da (the fixnum (car a)))
        (db (the fixnum (car b))))
    (or (< da db)
        (and (= da db)
             (< (the fixnum (cdr a)) (the fixnum (cdr b)))))))

(defun heap-push (heap item)
  (let ((idx (vector-push-extend item heap)))
    (declare (type fixnum idx))
    (loop while (> idx 0) do
      (let* ((parent (ash (- idx 1) -1))
             (parent-item (aref heap parent)))
        (declare (type fixnum parent))
        (if (heap-less-p item parent-item)
            (progn
              (setf (aref heap idx) parent-item)
              (setf idx parent))
            (return))))
    (setf (aref heap idx) item)))

(defun heap-pop (heap)
  (let* ((first-item (aref heap 0))
         (last-item (vector-pop heap))
         (n (length heap)))
    (declare (type fixnum n))
    (when (> n 0)
      (let ((idx 0))
        (declare (type fixnum idx))
        (loop
          (let ((left (+ (ash idx 1) 1)))
            (declare (type fixnum left))
            (when (>= left n)
              (return))
            (let* ((right (+ left 1))
                   (child (if (and (< right n)
                                   (heap-less-p (aref heap right) (aref heap left)))
                              right
                              left))
                   (child-item (aref heap child)))
              (declare (type fixnum right child))
              (if (heap-less-p child-item last-item)
                  (progn
                    (setf (aref heap idx) child-item)
                    (setf idx child))
                  (return)))))
        (setf (aref heap idx) last-item)))
    first-item))

(defun run-kernel (graph)
  (declare (type simple-vector graph))
  (let* ((n (length graph))
         (infinity (+ (* n 97) 1))
         (distances (make-array n :initial-element infinity))
         (pending (make-array 64 :adjustable t :fill-pointer 0)))
    (declare (type fixnum n infinity)
             (type simple-vector distances))
    (setf (svref distances 0) 0)
    (heap-push pending (cons 0 0))
    (loop while (> (length pending) 0) do
      (let* ((entry (heap-pop pending))
             (distance (the fixnum (car entry)))
             (vertex (the fixnum (cdr entry))))
        (declare (type fixnum distance vertex))
        (when (= distance (the fixnum (svref distances vertex)))
          (let* ((edges (svref graph vertex))
                 (m (length edges)))
            (declare (type fixnum m))
            (dotimes (i m)
              (declare (type fixnum i))
              (let* ((edge (aref edges i))
                     (target (the fixnum (car edge)))
                     (weight (the fixnum (cdr edge)))
                     (candidate (the fixnum (+ distance weight))))
                (declare (type fixnum target weight candidate))
                (when (< candidate (the fixnum (svref distances target)))
                  (setf (svref distances target) candidate)
                  (heap-push pending (cons candidate target)))))))))
    (let ((checksum 0)
          (reachable 0))
      (declare (type fixnum checksum reachable))
      (dotimes (vertex n)
        (declare (type fixnum vertex))
        (let ((d (the fixnum (svref distances vertex))))
          (when (< d infinity)
            (incf checksum (the fixnum (* (the fixnum (+ vertex 1)) d)))
            (incf reachable))))
      (list checksum reachable))))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
