;;;; Simulate the account ledger using a typed defstruct with signed-byte 64 slots and speed=3, safety=0.

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(declaim (optimize (speed 3) (safety 0) (debug 0)))

(defparameter *name* "native_struct_ledger")
(defparameter *description* "Native int64 struct account ledger with speed=3, safety=0")
(defparameter *default-size* 100000)
(defparameter *default-seed* 42)

(defstruct (ledger-account
            (:constructor make-ledger-account (ident balance rate floor-balance kind)))
  (ident 0 :type (signed-byte 64))
  (balance 0 :type (signed-byte 64))
  (tx-count 0 :type (signed-byte 64))
  (rate 0 :type (signed-byte 64))
  (points 0 :type (signed-byte 64))
  (floor-balance 0 :type (signed-byte 64))
  (penalties 0 :type (signed-byte 64))
  (kind 0 :type (signed-byte 64)))

(declaim (inline ledger-deposit ledger-withdraw ledger-score))

(defun ledger-deposit (acc amount)
  (declare (optimize (speed 3) (safety 0) (debug 0))
           (type ledger-account acc)
           (type (signed-byte 64) amount))
  (let ((bal (the (signed-byte 64) (+ (ledger-account-balance acc) amount))))
    (declare (type (signed-byte 64) bal))
    (setf (ledger-account-balance acc) bal
          (ledger-account-tx-count acc) (the (signed-byte 64) (1+ (ledger-account-tx-count acc))))
    (if (= (ledger-account-kind acc) 0)
        bal
        (let ((pts (the (signed-byte 64)
                        (+ (ledger-account-points acc)
                           (the (signed-byte 64)
                                (floor (the (signed-byte 64) (* amount (ledger-account-rate acc))) 10))))))
          (declare (type (signed-byte 64) pts))
          (setf (ledger-account-points acc) pts)
          (the (signed-byte 64) (+ bal pts))))))

(defun ledger-withdraw (acc amount)
  (declare (optimize (speed 3) (safety 0) (debug 0))
           (type ledger-account acc)
           (type (signed-byte 64) amount))
  (let ((eff-amount amount))
    (declare (type (signed-byte 64) eff-amount))
    (when (and (= (ledger-account-kind acc) 2)
               (< (the (signed-byte 64) (- (ledger-account-balance acc) amount))
                  (ledger-account-floor-balance acc)))
      (setf (ledger-account-penalties acc)
            (the (signed-byte 64) (1+ (ledger-account-penalties acc)))
            eff-amount 1))
    (let* ((cur (ledger-account-balance acc))
           (new-bal (if (<= eff-amount cur)
                        (the (signed-byte 64) (- cur eff-amount))
                        (the (signed-byte 64) (1- cur)))))
      (declare (type (signed-byte 64) cur new-bal))
      (setf (ledger-account-balance acc) new-bal
            (ledger-account-tx-count acc) (the (signed-byte 64) (1+ (ledger-account-tx-count acc))))
      new-bal)))

(defun ledger-score (acc)
  (declare (optimize (speed 3) (safety 0) (debug 0))
           (type ledger-account acc))
  (let ((base (the (signed-byte 64)
                   (+ (the (signed-byte 64) (* (ledger-account-balance acc) 3))
                      (the (signed-byte 64) (* (ledger-account-tx-count acc) 7))
                      (ledger-account-ident acc)))))
    (declare (type (signed-byte 64) base))
    (if (= (ledger-account-kind acc) 0)
        base
        (let ((rewards (the (signed-byte 64)
                            (+ base (the (signed-byte 64) (* (ledger-account-points acc) 5))))))
          (declare (type (signed-byte 64) rewards))
          (if (= (ledger-account-kind acc) 1)
              rewards
              (the (signed-byte 64)
                   (- rewards (the (signed-byte 64) (* (ledger-account-penalties acc) 11)))))))))

(defstruct (tx-op (:constructor make-tx-op (idx amount kind)))
  (idx 0 :type (signed-byte 64))
  (amount 0 :type (signed-byte 64))
  (kind 0 :type (signed-byte 64)))

(defun prepare (size seed)
  (declare (type (signed-byte 64) size seed))
  (when (< size 0)
    (error "size must be nonnegative"))
  (let ((state (logand seed #x7FFFFFFF))
        (ops (make-array size)))
    (declare (type (signed-byte 64) state)
             (type simple-vector ops))
    (dotimes (i size ops)
      (declare (type (signed-byte 64) i))
      (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
      (let ((idx (logand (ash state -4) 63))
            (amount (+ (mod (ash state -10) 97) 1))
            (kind (logand state 3)))
        (setf (svref ops i) (make-tx-op idx amount kind))))))

(defun run-kernel (data)
  (declare (optimize (speed 3) (safety 0) (debug 0))
           (type simple-vector data))
  (let ((accounts (make-array 64)))
    (declare (type simple-vector accounts))
    (dotimes (i 64)
      (declare (type (signed-byte 64) i))
      (let ((kind (mod i 3))
            (initial (+ 500 (* i 10))))
        (declare (type (signed-byte 64) kind initial))
        (setf (svref accounts i)
              (cond
                ((= kind 0)
                 (make-ledger-account i initial 0 0 0))
                ((= kind 1)
                 (make-ledger-account i initial (+ (mod i 5) 1) 0 1))
                (t
                 (make-ledger-account i initial (+ (mod i 4) 1) 200 2))))))
    (let* ((n (length data))
           (rounds (max 1 (floor n 425)))
           (rolling 0))
      (declare (type (signed-byte 64) n rounds rolling))
      (dotimes (round-idx rounds)
        (declare (type (signed-byte 64) round-idx))
        (let ((bonus (logand round-idx 7)))
          (declare (type (signed-byte 64) bonus))
          (dotimes (j n)
            (declare (type (signed-byte 64) j))
            (let* ((op (the tx-op (svref data j)))
                   (idx (tx-op-idx op))
                   (amount (tx-op-amount op))
                   (kind (tx-op-kind op))
                   (acc (the ledger-account (svref accounts (logand (+ idx round-idx) 63))))
                   (adj (the (signed-byte 64) (+ amount bonus))))
              (declare (type (signed-byte 64) idx amount kind adj))
              (cond
                ((= kind 0)
                 (setf rolling (logand (+ rolling (ledger-deposit acc adj)) #x3FFFFFFF)))
                ((= kind 1)
                 (setf rolling (logand (+ rolling (ledger-withdraw acc adj)) #x3FFFFFFF)))
                (t
                 (setf rolling (logand (+ rolling (ledger-score acc)) #x3FFFFFFF))))))))
      (let ((final-score 0)
             (tx-total 0))
        (declare (type (signed-byte 64) final-score tx-total))
        (dotimes (i 64)
          (declare (type (signed-byte 64) i))
          (let ((acc (the ledger-account (svref accounts i))))
            (incf final-score (ledger-score acc))
            (incf tx-total (ledger-account-tx-count acc))))
        (list rolling final-score tx-total)))))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
