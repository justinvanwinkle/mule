;;;; Sort, merge, and query weighted integer intervals via binary search.

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(defparameter *name* "interval_merging")
(defparameter *description* "Interval sorting, coalescing, and binary-search point queries")
(defparameter *default-size* 50000)
(defparameter *default-seed* 42)

(defstruct (interval-item (:constructor make-interval-item (start end weight)))
  (start 0 :type fixnum)
  (end 0 :type fixnum)
  (weight 0 :type fixnum))

(declaim (inline interval-less-p))
(defun interval-less-p (a b)
  (declare (type interval-item a b))
  (let ((sa (interval-item-start a))
        (sb (interval-item-start b)))
    (or (< sa sb)
        (and (= sa sb)
             (let ((ea (interval-item-end a))
                   (eb (interval-item-end b)))
               (or (< ea eb)
                   (and (= ea eb)
                        (< (interval-item-weight a)
                           (interval-item-weight b)))))))))

(defun prepare (size seed)
  (declare (type fixnum size seed))
  (when (< size 1)
    (error "size must be positive"))
  (let ((state (logand seed #x7FFFFFFF))
        (intervals (make-array size))
        (queries (make-array size))
        (span (* size 10)))
    (declare (type fixnum state span)
             (type simple-vector intervals queries))
    (dotimes (i size (cons intervals queries))
      (declare (type fixnum i))
      (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
      (let ((start (mod (ash state -4) span))
            (length (+ (mod (ash state -16) 35) 1))
            (weight (+ (mod (ash state -8) 19) 1)))
        (setf (svref intervals i) (make-interval-item start (+ start length) weight)))
      (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
      (setf (svref queries i) (mod (ash state -4) span)))))

(defun run-kernel (data)
  (let* ((raw-intervals (the simple-vector (car data)))
         (queries (the simple-vector (cdr data)))
         (ordered (sort (copy-seq raw-intervals) #'interval-less-p))
         (n-intervals (length ordered))
         (merged (make-array 64 :adjustable t :fill-pointer 0)))
    (declare (type simple-vector raw-intervals queries ordered)
             (type fixnum n-intervals))
    (let* ((first-item (the interval-item (svref ordered 0)))
           (cur-start (interval-item-start first-item))
           (cur-end (interval-item-end first-item))
           (cur-weight (interval-item-weight first-item)))
      (declare (type fixnum cur-start cur-end cur-weight))
      (loop for i of-type fixnum from 1 below n-intervals do
        (let* ((item (the interval-item (svref ordered i)))
               (start (interval-item-start item))
               (end (interval-item-end item))
               (weight (interval-item-weight item)))
          (declare (type fixnum start end weight))
          (if (<= start cur-end)
              (progn
                (when (> end cur-end)
                  (setf cur-end end))
                (incf cur-weight weight))
              (progn
                (vector-push-extend (make-interval-item cur-start cur-end cur-weight) merged)
                (setf cur-start start
                      cur-end end
                      cur-weight weight)))))
      (vector-push-extend (make-interval-item cur-start cur-end cur-weight) merged))
    (let* ((n-queries (length queries))
           (rounds (max 1 (floor n-queries 465)))
           (covered-queries 0)
           (weight-sum 0)
           (num-merged (length merged)))
      (declare (type fixnum n-queries rounds covered-queries weight-sum num-merged))
      (dotimes (round-idx rounds)
        (declare (type fixnum round-idx))
        (let ((shift (logand (the fixnum (* round-idx 7)) 63)))
          (declare (type fixnum shift))
          (dotimes (q-idx n-queries)
            (declare (type fixnum q-idx))
            (let ((target (the fixnum (+ (the fixnum (svref queries q-idx)) shift)))
                  (lo 0)
                  (hi (- num-merged 1))
                  (matched-weight 0))
              (declare (type fixnum target lo hi matched-weight))
              (loop while (<= lo hi) do
                (let* ((mid (ash (the fixnum (+ lo hi)) -1))
                       (m-item (the interval-item (aref merged mid)))
                       (m-start (interval-item-start m-item))
                       (m-end (interval-item-end m-item)))
                  (declare (type fixnum mid m-start m-end))
                  (cond
                    ((< target m-start)
                     (setf hi (- mid 1)))
                    ((> target m-end)
                     (setf lo (+ mid 1)))
                    (t
                     (setf matched-weight (interval-item-weight m-item))
                     (return)))))
              (when (> matched-weight 0)
                (incf covered-queries)
                (setf weight-sum (logand (the fixnum (+ weight-sum matched-weight)) #x3FFFFFFF)))))))
      (list num-merged covered-queries weight-sum))))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
