;;;; Simulate a 5-body gravitational system with double-float/signed-byte 64 declarations and speed=3, safety=0.

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(declaim (optimize (speed 3) (safety 0) (debug 0)))

(defparameter *name* "float_nbody_typed")
(defparameter *description* "Floating-point N-body simulation with float64/int64 annotations and speed=3, safety=0")
(defparameter *default-size* 150000)
(defparameter *default-seed* 42)

(defstruct (body (:constructor make-body (x y z vx vy vz mass)))
  (x 0.0d0 :type double-float)
  (y 0.0d0 :type double-float)
  (z 0.0d0 :type double-float)
  (vx 0.0d0 :type double-float)
  (vy 0.0d0 :type double-float)
  (vz 0.0d0 :type double-float)
  (mass 0.0d0 :type double-float))

(defun next-lcg (state)
  (declare (optimize (speed 3) (safety 0) (debug 0))
           (type (signed-byte 64) state))
  (the (signed-byte 64) (logand (+ (* state 1103515245) 12345) #x7FFFFFFF)))

(defun prepare (size seed)
  (declare (optimize (speed 3) (safety 0) (debug 0))
           (type (signed-byte 64) size seed))
  (when (< size 1)
    (error "size must be positive"))
  (let ((state (logand seed #x7FFFFFFF))
        (scale 0.0009765625d0)
        (bodies (make-array 5)))
    (declare (type (signed-byte 64) state)
             (type double-float scale)
             (type simple-vector bodies))
    (dotimes (i 5 (cons size bodies))
      (declare (type (signed-byte 64) i))
      (let (x y z vx vy vz mass)
        (setf state (next-lcg state)
              x (+ (* (coerce (- (mod (ash state -8) 2048) 1024) 'double-float) scale)
                   (coerce (* i 2) 'double-float)))
        (setf state (next-lcg state)
              y (* (coerce (- (mod (ash state -8) 2048) 1024) 'double-float) scale))
        (setf state (next-lcg state)
              z (* (coerce (- (mod (ash state -8) 2048) 1024) 'double-float) scale))
        (setf state (next-lcg state)
              vx (* (coerce (- (mod (ash state -8) 512) 256) 'double-float) scale))
        (setf state (next-lcg state)
              vy (* (coerce (- (mod (ash state -8) 512) 256) 'double-float) scale))
        (setf state (next-lcg state)
              vz (* (coerce (- (mod (ash state -8) 512) 256) 'double-float) scale))
        (setf state (next-lcg state)
              mass (* (coerce (+ (mod (ash state -8) 512) 256) 'double-float) scale))
        (setf (svref bodies i) (make-body x y z vx vy vz mass))))))

(declaim (inline pair-mag))
(defun pair-mag (dx dy dz dt)
  (declare (optimize (speed 3) (safety 0) (debug 0))
           (type double-float dx dy dz dt))
  (let* ((d2 (+ (* dx dx) (* dy dy) (* dz dz) 0.015625d0))
         (dist (sqrt (the (double-float 0.0d0) d2))))
    (declare (type double-float d2 dist))
    (/ dt (* d2 dist))))

(defun run-kernel (data)
  (declare (optimize (speed 3) (safety 0) (debug 0)))
  (let* ((steps (the (signed-byte 64) (car data)))
         (bodies (the simple-vector (cdr data)))
         (n (length bodies))
         (px (make-array n))
         (py (make-array n))
         (pz (make-array n))
         (vx (make-array n))
         (vy (make-array n))
         (vz (make-array n))
         (mass (make-array n))
         (dt 0.0078125d0))
    (declare (type (signed-byte 64) steps n)
             (type simple-vector px py pz vx vy vz mass)
             (type double-float dt))
    (dotimes (i n)
      (declare (type (signed-byte 64) i))
      (let ((b (the body (svref bodies i))))
        (setf (svref px i) (body-x b)
              (svref py i) (body-y b)
              (svref pz i) (body-z b)
              (svref vx i) (body-vx b)
              (svref vy i) (body-vy b)
              (svref vz i) (body-vz b)
              (svref mass i) (body-mass b))))
    (dotimes (step steps)
      (declare (type (signed-byte 64) step))
      (dotimes (i n)
        (declare (type (signed-byte 64) i))
        (let ((xi (the double-float (svref px i)))
              (yi (the double-float (svref py i)))
              (zi (the double-float (svref pz i)))
              (vxi (the double-float (svref vx i)))
              (vyi (the double-float (svref vy i)))
              (vzi (the double-float (svref vz i)))
              (mi (the double-float (svref mass i))))
          (declare (type double-float xi yi zi vxi vyi vzi mi))
          (loop for j of-type (signed-byte 64) from (1+ i) below n do
            (let* ((dx (- xi (the double-float (svref px j))))
                   (dy (- yi (the double-float (svref py j))))
                   (dz (- zi (the double-float (svref pz j))))
                   (mag (the double-float (pair-mag dx dy dz dt)))
                   (mj (the double-float (svref mass j))))
              (declare (type double-float dx dy dz mag mj))
              (setf vxi (- vxi (* dx (* mj mag)))
                    vyi (- vyi (* dy (* mj mag)))
                    vzi (- vzi (* dz (* mj mag))))
              (setf (svref vx j) (+ (the double-float (svref vx j)) (* dx (* mi mag)))
                    (svref vy j) (+ (the double-float (svref vy j)) (* dy (* mi mag)))
                    (svref vz j) (+ (the double-float (svref vz j)) (* dz (* mi mag))))))
          (setf (svref vx i) vxi
                (svref vy i) vyi
                (svref vz i) vzi)))
      (dotimes (i n)
        (declare (type (signed-byte 64) i))
        (setf (svref px i) (+ (the double-float (svref px i)) (* dt (the double-float (svref vx i))))
              (svref py i) (+ (the double-float (svref py i)) (* dt (the double-float (svref vy i))))
              (svref pz i) (+ (the double-float (svref pz i)) (* dt (the double-float (svref vz i)))))))
    (let ((energy 0.0d0)
          (spread 0.0d0))
      (declare (type double-float energy spread))
      (dotimes (i n)
        (declare (type (signed-byte 64) i))
        (let ((v2 (+ (* (the double-float (svref vx i)) (the double-float (svref vx i)))
                     (* (the double-float (svref vy i)) (the double-float (svref vy i)))
                     (* (the double-float (svref vz i)) (the double-float (svref vz i))))))
          (declare (type double-float v2))
          (setf energy (+ energy (* (* 0.5d0 (the double-float (svref mass i))) v2)))
          (setf spread (+ spread (* (+ (* (the double-float (svref px i)) (the double-float (svref px i)))
                                       (* (the double-float (svref py i)) (the double-float (svref py i)))
                                       (* (the double-float (svref pz i)) (the double-float (svref pz i))))
                                    (the double-float (svref mass i)))))
          (loop for j of-type (signed-byte 64) from (1+ i) below n do
            (let* ((dx (- (the double-float (svref px i)) (the double-float (svref px j))))
                   (dy (- (the double-float (svref py i)) (the double-float (svref py j))))
                   (dz (- (the double-float (svref pz i)) (the double-float (svref pz j))))
                   (d2 (+ (* dx dx) (* dy dy) (* dz dz) 0.015625d0))
                   (dist (sqrt (the (double-float 0.0d0) d2))))
              (declare (type double-float dx dy dz d2 dist))
              (setf energy (- energy (/ (* (the double-float (svref mass i)) (the double-float (svref mass j))) dist)))))))
      (list (values (truncate (* energy 1048576.0d0)))
            (values (truncate (* spread 65536.0d0)))))))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
