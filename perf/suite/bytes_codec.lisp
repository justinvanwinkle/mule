;;;; Decode, unmask, mutate, and checksum framed binary packets.

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(defparameter *name* "bytes_codec")
(defparameter *description* "Binary packet framing, LEB128 varint decoding, bytearray mutation, and checksums")
(defparameter *default-size* 35000)
(defparameter *default-seed* 42)

(defun encode-varint (buf value)
  (declare (type (vector (unsigned-byte 8)) buf)
           (type fixnum value))
  (let ((v value))
    (declare (type fixnum v))
    (loop while (>= v #x80) do
      (vector-push-extend (logior (logand v #x7F) #x80) buf)
      (setf v (ash v -7)))
    (vector-push-extend (logand v #x7F) buf)))

(defun prepare (size seed)
  (declare (type fixnum size seed))
  (when (< size 1)
    (error "size must be positive"))
  (let ((state (logand seed #x7FFFFFFF))
        (packets (make-array size)))
    (declare (type fixnum state)
             (type simple-vector packets))
    (dotimes (i size packets)
      (declare (type fixnum i))
      (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
      (let ((seq-id (logand (ash state -4) #x3FFFF))
            (mask (logand (ash state -12) #xFF))
            (payload-len (+ 8 (mod (ash state -20) 25)))
            (buf (make-array 40 :element-type '(unsigned-byte 8) :fill-pointer 0 :adjustable t)))
        (declare (type fixnum seq-id mask payload-len))
        (encode-varint buf seq-id)
        (vector-push-extend mask buf)
        (encode-varint buf payload-len)
        (dotimes (j payload-len)
          (declare (type fixnum j))
          (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
          (let ((raw (logand (ash state -16) #xFF)))
            (vector-push-extend (logxor raw (logand (+ mask (* j 13)) #xFF)) buf)))
        (let ((packet (make-array (length buf) :element-type '(unsigned-byte 8))))
          (replace packet buf)
          (setf (svref packets i) packet))))))

(defun decode-varint (packet pos)
  (declare (type (simple-array (unsigned-byte 8) (*)) packet)
           (type fixnum pos))
  (let ((result 0)
        (shift 0)
        (cur pos))
    (declare (type fixnum result shift cur))
    (loop
      (let ((byte (aref packet cur)))
        (incf cur)
        (setf result (logior result (the fixnum (ash (logand byte #x7F) shift))))
        (when (zerop (logand byte #x80))
          (return (values result cur)))
        (incf shift 7)))))

(defun run-kernel (data)
  (declare (type simple-vector data))
  (let ((packet-count 0)
        (seq-sum 0)
        (total-bytes 0)
        (digest 0)
        (n (length data)))
    (declare (type fixnum packet-count seq-sum total-bytes digest n))
    (dotimes (i n)
      (declare (type fixnum i))
      (let ((packet (the (simple-array (unsigned-byte 8) (*)) (svref data i))))
        (multiple-value-bind (seq-id pos1) (decode-varint packet 0)
          (declare (type fixnum seq-id pos1))
          (let ((mask (aref packet pos1)))
            (declare (type fixnum mask))
            (multiple-value-bind (payload-len pos2) (decode-varint packet (1+ pos1))
              (declare (type fixnum payload-len pos2))
              (let ((decoded (make-array payload-len :element-type '(unsigned-byte 8))))
                (declare (type (simple-array (unsigned-byte 8) (*)) decoded))
                (dotimes (j payload-len)
                  (declare (type fixnum j))
                  (setf (aref decoded j)
                        (logxor (aref packet (+ pos2 j))
                                (logand (+ mask (* j 13)) #xFF))))
                (let ((k 0)
                      (limit (1- payload-len)))
                  (declare (type fixnum k limit))
                  (loop while (< k limit) do
                    (let ((left (aref decoded k))
                          (right (aref decoded (1+ k))))
                      (setf (aref decoded k) (logand (+ right 3) #xFF)
                            (aref decoded (1+ k)) (logxor left #x5A))
                      (incf k 2))))
                (let ((s1 1)
                      (s2 0))
                  (declare (type fixnum s1 s2))
                  (dotimes (j payload-len)
                    (declare (type fixnum j))
                    (setf s1 (mod (+ s1 (aref decoded j)) 65521)
                          s2 (mod (+ s2 s1) 65521)))
                  (let ((packet-checksum (logior (ash s2 16) s1)))
                    (declare (type fixnum packet-checksum))
                    (setf digest (logand (+ (* digest 33) packet-checksum seq-id) #x3FFFFFFF))
                    (incf packet-count)
                    (incf seq-sum seq-id)
                    (incf total-bytes payload-len)))))))))
    (list packet-count seq-sum total-bytes digest)))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
