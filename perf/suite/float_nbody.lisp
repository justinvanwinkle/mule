;;;; Simulate a 5-body gravitational system using symplectic Euler integration.

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(defparameter *name* "float_nbody")
(defparameter *description* "Floating-point N-body gravitational orbital simulation")
(defparameter *default-size* 150000)
(defparameter *default-seed* 42)

(defstruct (body (:constructor make-body (x y z vx vy vz mass)))
  (x 0.0d0)
  (y 0.0d0)
  (z 0.0d0)
  (vx 0.0d0)
  (vy 0.0d0)
  (vz 0.0d0)
  (mass 0.0d0))

(defun next-lcg (state)
  (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))

(defun prepare (size seed)
  (when (< size 1)
    (error "size must be positive"))
  (let ((state (logand seed #x7FFFFFFF))
        (scale 0.0009765625d0)
        (bodies (make-array 5)))
    (dotimes (i 5 (cons size bodies))
      (let (x y z vx vy vz mass)
        (setf state (next-lcg state)
              x (+ (* (coerce (- (mod (ash state -8) 2048) 1024) 'double-float) scale)
                   (coerce (* i 2) 'double-float)))
        (setf state (next-lcg state)
              y (* (coerce (- (mod (ash state -8) 2048) 1024) 'double-float) scale))
        (setf state (next-lcg state)
              z (* (coerce (- (mod (ash state -8) 2048) 1024) 'double-float) scale))
        (setf state (next-lcg state)
              vx (* (coerce (- (mod (ash state -8) 512) 256) 'double-float) scale))
        (setf state (next-lcg state)
              vy (* (coerce (- (mod (ash state -8) 512) 256) 'double-float) scale))
        (setf state (next-lcg state)
              vz (* (coerce (- (mod (ash state -8) 512) 256) 'double-float) scale))
        (setf state (next-lcg state)
              mass (* (coerce (+ (mod (ash state -8) 512) 256) 'double-float) scale))
        (setf (svref bodies i) (make-body x y z vx vy vz mass))))))

(defun pair-mag (dx dy dz dt)
  (let* ((d2 (+ (* dx dx) (* dy dy) (* dz dz) 0.015625d0))
         (dist (sqrt d2)))
    (/ dt (* d2 dist))))

(defun run-kernel (data)
  (let* ((steps (car data))
         (bodies (cdr data))
         (n (length bodies))
         (px (make-array n))
         (py (make-array n))
         (pz (make-array n))
         (vx (make-array n))
         (vy (make-array n))
         (vz (make-array n))
         (mass (make-array n))
         (dt 0.0078125d0))
    (dotimes (i n)
      (let ((b (svref bodies i)))
        (setf (svref px i) (body-x b)
              (svref py i) (body-y b)
              (svref pz i) (body-z b)
              (svref vx i) (body-vx b)
              (svref vy i) (body-vy b)
              (svref vz i) (body-vz b)
              (svref mass i) (body-mass b))))
    (dotimes (step steps)
      (dotimes (i n)
        (let ((xi (svref px i))
              (yi (svref py i))
              (zi (svref pz i))
              (vxi (svref vx i))
              (vyi (svref vy i))
              (vzi (svref vz i))
              (mi (svref mass i)))
          (loop for j from (1+ i) below n do
            (let* ((dx (- xi (svref px j)))
                   (dy (- yi (svref py j)))
                   (dz (- zi (svref pz j)))
                   (mag (pair-mag dx dy dz dt))
                   (mj (svref mass j)))
              (setf vxi (- vxi (* dx (* mj mag)))
                    vyi (- vyi (* dy (* mj mag)))
                    vzi (- vzi (* dz (* mj mag))))
              (setf (svref vx j) (+ (svref vx j) (* dx (* mi mag)))
                    (svref vy j) (+ (svref vy j) (* dy (* mi mag)))
                    (svref vz j) (+ (svref vz j) (* dz (* mi mag))))))
          (setf (svref vx i) vxi
                (svref vy i) vyi
                (svref vz i) vzi)))
      (dotimes (i n)
        (setf (svref px i) (+ (svref px i) (* dt (svref vx i)))
              (svref py i) (+ (svref py i) (* dt (svref vy i)))
              (svref pz i) (+ (svref pz i) (* dt (svref vz i))))))
    (let ((energy 0.0d0)
          (spread 0.0d0))
      (dotimes (i n)
        (let ((v2 (+ (* (svref vx i) (svref vx i))
                     (* (svref vy i) (svref vy i))
                     (* (svref vz i) (svref vz i)))))
          (setf energy (+ energy (* (* 0.5d0 (svref mass i)) v2)))
          (setf spread (+ spread (* (+ (* (svref px i) (svref px i))
                                       (* (svref py i) (svref py i))
                                       (* (svref pz i) (svref pz i)))
                                    (svref mass i))))
          (loop for j from (1+ i) below n do
            (let* ((dx (- (svref px i) (svref px j)))
                   (dy (- (svref py i) (svref py j)))
                   (dz (- (svref pz i) (svref pz j)))
                   (d2 (+ (* dx dx) (* dy dy) (* dz dz) 0.015625d0))
                   (dist (sqrt d2)))
              (setf energy (- energy (/ (* (svref mass i) (svref mass j)) dist)))))))
      (list (values (truncate (* energy 1048576.0d0)))
            (values (truncate (* spread 65536.0d0)))))))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
