;;;; Simulate a 5-body gravitational system using symplectic Euler integration.

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(defparameter *name* "float_nbody")
(defparameter *description* "Floating-point N-body gravitational orbital simulation")
(defparameter *default-size* 150000)
(defparameter *default-seed* 42)

(defstruct (body (:constructor make-body (x y z vx vy vz mass)))
  (x 0.0d0 :type double-float)
  (y 0.0d0 :type double-float)
  (z 0.0d0 :type double-float)
  (vx 0.0d0 :type double-float)
  (vy 0.0d0 :type double-float)
  (vz 0.0d0 :type double-float)
  (mass 0.0d0 :type double-float))

(defun next-lcg (state)
  (declare (type fixnum state))
  (the fixnum (logand (+ (* state 1103515245) 12345) #x7FFFFFFF)))

(defun prepare (size seed)
  (declare (type fixnum size seed))
  (when (< size 1)
    (error "size must be positive"))
  (let ((state (logand seed #x7FFFFFFF))
        (scale 0.0009765625d0)
        (bodies (make-array 5)))
    (declare (type fixnum state)
             (type double-float scale)
             (type simple-vector bodies))
    (dotimes (i 5 (cons size bodies))
      (declare (type fixnum i))
      (let (x y z vx vy vz mass)
        (setf state (next-lcg state)
              x (+ (* (coerce (- (mod (ash state -8) 2048) 1024) 'double-float) scale)
                   (coerce (* i 2) 'double-float)))
        (setf state (next-lcg state)
              y (* (coerce (- (mod (ash state -8) 2048) 1024) 'double-float) scale))
        (setf state (next-lcg state)
              z (* (coerce (- (mod (ash state -8) 2048) 1024) 'double-float) scale))
        (setf state (next-lcg state)
              vx (* (coerce (- (mod (ash state -8) 512) 256) 'double-float) scale))
        (setf state (next-lcg state)
              vy (* (coerce (- (mod (ash state -8) 512) 256) 'double-float) scale))
        (setf state (next-lcg state)
              vz (* (coerce (- (mod (ash state -8) 512) 256) 'double-float) scale))
        (setf state (next-lcg state)
              mass (* (coerce (+ (mod (ash state -8) 512) 256) 'double-float) scale))
        (setf (svref bodies i) (make-body x y z vx vy vz mass))))))

(declaim (inline pair-mag))
(defun pair-mag (dx dy dz dt)
  (declare (type double-float dx dy dz dt))
  (let* ((d2 (+ (* dx dx) (* dy dy) (* dz dz) 0.015625d0))
         (dist (sqrt (the (double-float 0.0d0) d2))))
    (declare (type double-float d2 dist))
    (/ dt (* d2 dist))))

(defun run-kernel (data)
  (let* ((steps (the fixnum (car data)))
         (bodies (the simple-vector (cdr data)))
         (n (length bodies))
         (px (make-array n :element-type 'double-float))
         (py (make-array n :element-type 'double-float))
         (pz (make-array n :element-type 'double-float))
         (vx (make-array n :element-type 'double-float))
         (vy (make-array n :element-type 'double-float))
         (vz (make-array n :element-type 'double-float))
         (mass (make-array n :element-type 'double-float))
         (dt 0.0078125d0))
    (declare (type fixnum steps n)
             (type (simple-array double-float (*)) px py pz vx vy vz mass)
             (type double-float dt))
    (dotimes (i n)
      (declare (type fixnum i))
      (let ((b (the body (svref bodies i))))
        (setf (aref px i) (body-x b)
              (aref py i) (body-y b)
              (aref pz i) (body-z b)
              (aref vx i) (body-vx b)
              (aref vy i) (body-vy b)
              (aref vz i) (body-vz b)
              (aref mass i) (body-mass b))))
    (dotimes (step steps)
      (declare (type fixnum step))
      (dotimes (i n)
        (declare (type fixnum i))
        (let ((xi (aref px i))
              (yi (aref py i))
              (zi (aref pz i))
              (vxi (aref vx i))
              (vyi (aref vy i))
              (vzi (aref vz i))
              (mi (aref mass i)))
          (declare (type double-float xi yi zi vxi vyi vzi mi))
          (loop for j of-type fixnum from (1+ i) below n do
            (let* ((dx (- xi (aref px j)))
                   (dy (- yi (aref py j)))
                   (dz (- zi (aref pz j)))
                   (mag (pair-mag dx dy dz dt))
                   (mj (aref mass j)))
              (declare (type double-float dx dy dz mag mj))
              (setf vxi (- vxi (* dx (* mj mag)))
                    vyi (- vyi (* dy (* mj mag)))
                    vzi (- vzi (* dz (* mj mag))))
              (setf (aref vx j) (+ (aref vx j) (* dx (* mi mag)))
                    (aref vy j) (+ (aref vy j) (* dy (* mi mag)))
                    (aref vz j) (+ (aref vz j) (* dz (* mi mag))))))
          (setf (aref vx i) vxi
                (aref vy i) vyi
                (aref vz i) vzi)))
      (dotimes (i n)
        (declare (type fixnum i))
        (setf (aref px i) (+ (aref px i) (* dt (aref vx i)))
              (aref py i) (+ (aref py i) (* dt (aref vy i)))
              (aref pz i) (+ (aref pz i) (* dt (aref vz i))))))
    (let ((energy 0.0d0)
          (spread 0.0d0))
      (declare (type double-float energy spread))
      (dotimes (i n)
        (declare (type fixnum i))
        (let ((v2 (+ (* (aref vx i) (aref vx i))
                     (* (aref vy i) (aref vy i))
                     (* (aref vz i) (aref vz i)))))
          (declare (type double-float v2))
          (setf energy (+ energy (* (* 0.5d0 (aref mass i)) v2)))
          (setf spread (+ spread (* (+ (* (aref px i) (aref px i))
                                       (* (aref py i) (aref py i))
                                       (* (aref pz i) (aref pz i)))
                                    (aref mass i))))
          (loop for j of-type fixnum from (1+ i) below n do
            (let* ((dx (- (aref px i) (aref px j)))
                   (dy (- (aref py i) (aref py j)))
                   (dz (- (aref pz i) (aref pz j)))
                   (d2 (+ (* dx dx) (* dy dy) (* dz dz) 0.015625d0))
                   (dist (sqrt (the (double-float 0.0d0) d2))))
              (declare (type double-float dx dy dz d2 dist))
              (setf energy (- energy (/ (* (aref mass i) (aref mass j)) dist)))))))
      (list (values (truncate (* energy 1048576.0d0)))
            (values (truncate (* spread 65536.0d0)))))))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
