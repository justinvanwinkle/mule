;;;; Simulate a polymorphic account ledger with inheritance and call-next-method dispatch.

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(defparameter *name* "account_ledger")
(defparameter *description* "Polymorphic class hierarchy with super() calls and slot updates")
(defparameter *default-size* 100000)
(defparameter *default-seed* 42)

(defclass account ()
  ((ident :initarg :ident :accessor account-ident)
   (balance :initarg :balance :accessor account-balance)
   (tx-count :initform 0 :accessor account-tx-count)))

(defclass rewards-account (account)
  ((rate :initarg :rate :accessor rewards-account-rate)
   (points :initform 0 :accessor rewards-account-points)))

(defclass vault-account (rewards-account)
  ((floor-balance :initarg :floor-balance :accessor vault-account-floor)
   (penalties :initform 0 :accessor vault-account-penalties)))

(defgeneric deposit (acc amount))
(defgeneric withdraw (acc amount))
(defgeneric score (acc))

(defmethod deposit ((acc account) amount)
  (let ((new-bal (+ (account-balance acc) amount)))
    (setf (account-balance acc) new-bal)
    (setf (account-tx-count acc) (+ (account-tx-count acc) 1))
    new-bal))

(defmethod withdraw ((acc account) amount)
  (let* ((cur (account-balance acc))
         (new-bal (if (<= amount cur)
                      (- cur amount)
                      (- cur 1))))
    (setf (account-balance acc) new-bal)
    (setf (account-tx-count acc) (+ (account-tx-count acc) 1))
    new-bal))

(defmethod score ((acc account))
  (+ (* (account-balance acc) 3)
     (* (account-tx-count acc) 7)
     (account-ident acc)))

(defmethod deposit ((acc rewards-account) amount)
  (let* ((bal (call-next-method))
         (pts (+ (rewards-account-points acc)
                 (floor (* amount (rewards-account-rate acc)) 10))))
    (setf (rewards-account-points acc) pts)
    (+ bal pts)))

(defmethod score ((acc rewards-account))
  (+ (call-next-method)
     (* (rewards-account-points acc) 5)))

(defmethod withdraw ((acc vault-account) amount)
  (if (< (- (account-balance acc) amount)
         (vault-account-floor acc))
      (progn
        (setf (vault-account-penalties acc)
              (+ (vault-account-penalties acc) 1))
        (call-next-method acc 1))
      (call-next-method acc amount)))

(defmethod score ((acc vault-account))
  (- (call-next-method)
     (* (vault-account-penalties acc) 11)))

(defstruct (tx-op (:constructor make-tx-op (idx amount kind)))
  (idx 0)
  (amount 0)
  (kind 0))

(defun prepare (size seed)
  (when (< size 0)
    (error "size must be nonnegative"))
  (let ((state (logand seed #x7FFFFFFF))
        (ops (make-array size)))
    (dotimes (i size ops)
      (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
      (let ((idx (logand (ash state -4) 63))
            (amount (+ (mod (ash state -10) 97) 1))
            (kind (logand state 3)))
        (setf (svref ops i) (make-tx-op idx amount kind))))))

(defun run-kernel (data)
  (let ((accounts (make-array 64)))
    (dotimes (i 64)
      (let ((kind (mod i 3))
            (initial (+ 500 (* i 10))))
        (setf (svref accounts i)
              (cond
                ((= kind 0)
                 (make-instance 'account :ident i :balance initial))
                ((= kind 1)
                 (make-instance 'rewards-account :ident i :balance initial :rate (+ (mod i 5) 1)))
                (t
                 (make-instance 'vault-account :ident i :balance initial :rate (+ (mod i 4) 1) :floor-balance 200))))))
    (let* ((n (length data))
           (rounds (max 1 (floor n 425)))
           (rolling 0))
      (dotimes (round-idx rounds)
        (let ((bonus (logand round-idx 7)))
          (dotimes (j n)
            (let* ((op (svref data j))
                   (idx (tx-op-idx op))
                   (amount (tx-op-amount op))
                   (kind (tx-op-kind op))
                   (acc (svref accounts (logand (+ idx round-idx) 63)))
                   (adj (+ amount bonus)))
              (cond
                ((= kind 0)
                 (setf rolling (logand (+ rolling (deposit acc adj)) #x3FFFFFFF)))
                ((= kind 1)
                 (setf rolling (logand (+ rolling (withdraw acc adj)) #x3FFFFFFF)))
                (t
                 (setf rolling (logand (+ rolling (score acc)) #x3FFFFFFF))))))))
      (let ((final-score 0)
            (tx-total 0))
        (dotimes (i 64)
          (let ((acc (svref accounts i)))
            (incf final-score (score acc))
            (incf tx-total (account-tx-count acc))))
        (list rolling final-score tx-total)))))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
