;;;; Parse access logs and aggregate routes, statuses, bytes, and latency.

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(defparameter *name* "log_aggregation")
(defparameter *description* "Access-log parsing, numeric conversion, and dictionary aggregation")
(defparameter *default-size* 100000)
(defparameter *default-seed* 42)

(defun split-whitespace (line)
  (declare (type simple-string line))
  (let ((n (length line))
        (i 0)
        (fields nil))
    (declare (type fixnum n i))
    (loop while (< i n) do
      (loop while (and (< i n) (char= (schar line i) #\Space)) do (incf i))
      (when (< i n)
        (let ((start i))
          (declare (type fixnum start))
          (loop while (and (< i n) (char/= (schar line i) #\Space)) do (incf i))
          (push (subseq line start i) fields))))
    (nreverse fields)))

(defun rsplit-after-char (text ch)
  (declare (type simple-string text)
           (type character ch))
  (let ((pos (position ch text :from-end t)))
    (if pos
        (subseq text (+ pos 1))
        text)))

(defun prepare (size seed)
  (declare (type fixnum size seed))
  (when (< size 0)
    (error "size must be nonnegative"))
  (let ((state (logand seed #xFFFFFFFF))
        (logs (make-array size))
        (statuses #(200 201 304 404 500)))
    (declare (type (unsigned-byte 32) state)
             (type simple-vector logs statuses))
    (dotimes (i size logs)
      (declare (type fixnum i))
      (setf state (logand (+ (* state 1664525) 1013904223) #xFFFFFFFF))
      (let ((route (mod (ash state -8) 32))
            (client (+ (mod (ash state -16) 254) 1))
            (method (if (/= (logand state 4) 0) "POST" "GET"))
            (status (svref statuses (mod (ash state -24) (length statuses))))
            (latency (+ (mod (ash state -3) 2000) 1))
            (response-bytes (mod (ash state -10) 8192)))
        (setf (svref logs i)
              (concatenate 'string
                           "10.0.0." (write-to-string client)
                           " " method
                           " /api/items/" (write-to-string route)
                           " " (write-to-string status)
                           " " (write-to-string response-bytes)
                           " " (write-to-string latency)))))))

(defun run-kernel (data)
  (declare (type simple-vector data))
  (let ((routes (make-hash-table :test 'equal))
        (statuses (make-hash-table :test 'eql))
        (count 0)
        (byte-total 0)
        (latency-total 0)
        (latency-max 0)
        (client-checksum 0)
        (n (length data)))
    (declare (type fixnum count byte-total latency-total latency-max client-checksum n))
    (dotimes (i n)
      (declare (type fixnum i))
      (let* ((line (the simple-string (svref data i)))
             (fields (split-whitespace line))
             (f0 (the simple-string (first fields)))
             (f1 (the simple-string (second fields)))
             (route (the simple-string (third fields)))
             (f3 (the simple-string (fourth fields)))
             (f4 (the simple-string (fifth fields)))
             (f5 (the simple-string (sixth fields)))
             (client (the fixnum (parse-integer (rsplit-after-char f0 #\.))))
             (method-weight (if (string= f1 "POST") 2 1))
             (status (the fixnum (parse-integer f3)))
             (response-bytes (the fixnum (parse-integer f4)))
             (latency (the fixnum (parse-integer f5)))
             (group (gethash route routes)))
        (declare (type fixnum client method-weight status response-bytes latency))
        (when (null group)
          (setf group (make-array 3 :initial-element 0))
          (setf (gethash route routes) group))
        (let ((g (the simple-vector group)))
          (setf (svref g 0) (the fixnum (+ (the fixnum (svref g 0)) 1)))
          (setf (svref g 1) (the fixnum (+ (the fixnum (svref g 1)) latency)))
          (when (> latency (the fixnum (svref g 2)))
            (setf (svref g 2) latency)))
        (setf (gethash status statuses)
              (the fixnum (+ (the fixnum (gethash status statuses 0)) 1)))
        (incf count)
        (incf byte-total response-bytes)
        (incf latency-total latency)
        (when (> latency latency-max)
          (setf latency-max latency))
        (incf client-checksum (the fixnum (* client method-weight)))))
    (let ((route-checksum 0)
          (status-checksum 0))
      (declare (type fixnum route-checksum status-checksum))
      (maphash (lambda (route group)
                 (declare (type simple-string route)
                          (type simple-vector group))
                 (let ((route-number (+ (the fixnum (parse-integer (rsplit-after-char route #\/))) 1)))
                   (incf route-checksum
                         (the fixnum (* route-number
                                        (the fixnum (+ (the fixnum (svref group 0))
                                                       (the fixnum (svref group 1))
                                                       (the fixnum (svref group 2)))))))))
               routes)
      (maphash (lambda (status status-count)
                 (declare (type fixnum status status-count))
                 (incf status-checksum (the fixnum (* status status-count))))
               statuses)
      (list count
            byte-total
            latency-total
            latency-max
            route-checksum
            status-checksum
            client-checksum))))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
