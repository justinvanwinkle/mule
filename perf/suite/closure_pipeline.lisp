;;;; Compose and invoke stateful lexical closures across a signal pipeline.

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(defparameter *name* "closure_pipeline")
(defparameter *description* "Higher-order function pipelines with mutable lexical closure state")
(defparameter *default-size* 100000)
(defparameter *default-seed* 42)

(defun make-stepper (seed mul)
  (declare (type fixnum seed mul))
  (let ((acc seed))
    (declare (type fixnum acc))
    (lambda (x)
      (declare (type fixnum x))
      (setf acc (logand (the fixnum (+ (the fixnum (* acc mul)) x)) #x3FFFFFFF))
      acc)))

(defun apply-pipeline (val s1 s2 s3)
  (declare (type fixnum val)
           (type function s1 s2 s3))
  (the fixnum (funcall s3 (the fixnum (funcall s2 (the fixnum (funcall s1 val)))))))

(defun prepare (size seed)
  (declare (type fixnum size seed))
  (when (< size 0)
    (error "size must be nonnegative"))
  (let ((state (logand seed #x7FFFFFFF))
        (values (make-array size)))
    (declare (type fixnum state)
             (type simple-vector values))
    (dotimes (i size values)
      (declare (type fixnum i))
      (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
      (setf (svref values i) (logand (ash state -6) #xFFFF)))))

(defun run-kernel (data)
  (declare (type simple-vector data))
  (let* ((s1 (make-stepper 19 31))
         (s2 (make-stepper 47 17))
         (s3 (make-stepper 83 13))
         (n (length data))
         (rounds (max 1 (floor n 580)))
         (total 0)
         (odd-count 0))
    (declare (type fixnum n rounds total odd-count))
    (dotimes (round-idx rounds)
      (declare (type fixnum round-idx))
      (let ((bias (logand round-idx 15)))
        (declare (type fixnum bias))
        (dotimes (i n)
          (declare (type fixnum i))
          (let* ((val (the fixnum (svref data i)))
                 (out (apply-pipeline (the fixnum (+ val bias)) s1 s2 s3)))
            (declare (type fixnum val out))
            (setf total (logand (the fixnum (+ total out)) #x3FFFFFFF))
            (when (= (logand out 1) 1)
              (incf odd-count))))))
    (list total odd-count)))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
