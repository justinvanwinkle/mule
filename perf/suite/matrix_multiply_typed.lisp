;;;; Multiply dense integer matrices with signed-byte 64 declarations and speed=3, safety=0.

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(declaim (optimize (speed 3) (safety 0) (debug 0)))

(defparameter *name* "matrix_multiply_typed")
(defparameter *description* "Dense 2D matrix multiplication with int64 annotations and speed=3, safety=0")
(defparameter *default-size* 490)
(defparameter *default-seed* 42)

(defun prepare (size seed)
  (declare (type (signed-byte 64) size seed))
  (when (< size 1)
    (error "size must be positive"))
  (let ((state (logand seed #x7FFFFFFF))
        (left (make-array size))
        (right (make-array size)))
    (declare (type (signed-byte 64) state)
             (type simple-vector left right))
    (dotimes (i size (cons left right))
      (declare (type (signed-byte 64) i))
      (let ((row-a (make-array size :element-type '(signed-byte 64)))
            (row-b (make-array size :element-type '(signed-byte 64))))
        (declare (type (simple-array (signed-byte 64) (*)) row-a row-b))
        (dotimes (j size)
          (declare (type (signed-byte 64) j))
          (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
          (setf (aref row-a j) (- (mod (ash state -8) 61) 30))
          (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
          (setf (aref row-b j) (- (mod (ash state -8) 61) 30)))
        (setf (svref left i) row-a
              (svref right i) row-b)))))

(defun run-kernel (data)
  (declare (optimize (speed 3) (safety 0) (debug 0)))
  (let* ((left (the simple-vector (car data)))
         (right (the simple-vector (cdr data)))
         (n (length left))
         (transposed (make-array n)))
    (declare (type simple-vector left right transposed)
             (type (signed-byte 64) n))
    (dotimes (col n)
      (declare (type (signed-byte 64) col))
      (let ((t-row (make-array n :element-type '(signed-byte 64))))
        (declare (type (simple-array (signed-byte 64) (*)) t-row))
        (dotimes (row n)
          (declare (type (signed-byte 64) row))
          (setf (aref t-row row)
                (aref (the (simple-array (signed-byte 64) (*)) (svref right row)) col)))
        (setf (svref transposed col) t-row)))
    (let ((trace 0)
          (frobenius 0))
      (declare (type (signed-byte 64) trace frobenius))
      (dotimes (i n)
        (declare (type (signed-byte 64) i))
        (let ((row-a (the (simple-array (signed-byte 64) (*)) (svref left i))))
          (dotimes (j n)
            (declare (type (signed-byte 64) j))
            (let ((col-b (the (simple-array (signed-byte 64) (*)) (svref transposed j)))
                  (acc 0))
              (declare (type (signed-byte 64) acc))
              (dotimes (k n)
                (declare (type (signed-byte 64) k))
                (incf acc (the (signed-byte 64)
                               (* (aref row-a k) (aref col-b k)))))
              (when (= i j)
                (incf trace acc))
              (setf frobenius
                    (logand (the (signed-byte 64)
                                 (+ frobenius (the (signed-byte 64) (* acc acc))))
                            #x3FFFFFFF))))))
      (list trace frobenius))))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
