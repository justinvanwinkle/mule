;;;; Scan and evaluate compact JSON-like metric objects without a JSON library.

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(defparameter *name* "json_tokenizer")
(defparameter *description* "Handwritten scanner and evaluator for JSON-like metric payloads")
(defparameter *default-size* 50000)
(defparameter *default-seed* 42)

(defparameter *tags* #("cpu" "mem" "disk" "net" "io" "gpu"))

(defun prepare (size seed)
  (declare (type fixnum size seed))
  (when (< size 0)
    (error "size must be nonnegative"))
  (let ((state (logand seed #x7FFFFFFF))
        (payloads (make-array size))
        (tags *tags*)
        (n-tags (length *tags*)))
    (declare (type fixnum state n-tags)
             (type simple-vector payloads tags))
    (dotimes (i size payloads)
      (declare (type fixnum i))
      (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
      (let ((tag (the simple-string (svref tags (mod (ash state -4) n-tags))))
            (v1 (mod (ash state -8) 500))
            (v2 (mod (ash state -15) 500))
            (v3 (- (mod (ash state -20) 200) 50))
            (active (if (/= (logand state 8) 0) "true" "false")))
        (setf (svref payloads i)
              (concatenate 'string
                           "{\"tag\":\"" tag
                           "\",\"vals\":[" (write-to-string v1)
                           "," (write-to-string v2)
                           "," (write-to-string v3)
                           "],\"ok\":" active "}"))))))

(defun scan-payload (text)
  (declare (type simple-string text))
  (let ((n (length text))
        (i 0)
        (tag "")
        (val-sum 0)
        (active 0))
    (declare (type fixnum n i val-sum active)
             (type simple-string tag))
    (loop while (< i n) do
      (let ((ch (schar text i)))
        (cond
          ((char= ch #\")
           (let* ((end (the fixnum (position #\" text :start (+ i 1))))
                  (word (subseq text (+ i 1) end)))
             (setf i (+ end 1))
             (when (string= word "tag")
               (let* ((q1 (the fixnum (position #\" text :start i)))
                      (q2 (the fixnum (position #\" text :start (+ q1 1)))))
                 (setf tag (subseq text (+ q1 1) q2))
                 (setf i (+ q2 1))))))
          ((or (char= ch #\[) (char= ch #\,))
           (incf i)
           (loop while (and (< i n) (char= (schar text i) #\Space)) do
             (incf i))
           (when (and (< i n)
                      (let ((c (schar text i)))
                        (or (char= c #\-) (and (char<= #\0 c) (char<= c #\9)))))
             (let ((start i))
               (declare (type fixnum start))
               (incf i)
               (loop while (and (< i n)
                                (let ((c (schar text i)))
                                  (and (char<= #\0 c) (char<= c #\9))))
                     do (incf i))
               (incf val-sum (the fixnum (parse-integer text :start start :end i))))))
          ((and (char= ch #\t)
                (<= (+ i 4) n)
                (string= text "true" :start1 i :end1 (+ i 4)))
           (setf active 1)
           (incf i 4))
          (t
           (incf i)))))
    (values tag val-sum active)))

(defun run-kernel (data)
  (declare (type simple-vector data))
  (let* ((by-tag (make-hash-table :test 'equal))
         (n (length data))
         (rounds (max 1 (floor n 1000)))
         (active-count 0)
         (total-sum 0))
    (declare (type fixnum n rounds active-count total-sum))
    (dotimes (round-idx rounds)
      (declare (type fixnum round-idx))
      (let ((weight (+ (logand round-idx 3) 1)))
        (declare (type fixnum weight))
        (dotimes (j n)
          (declare (type fixnum j))
          (multiple-value-bind (tag val-sum active)
              (scan-payload (the simple-string (svref data j)))
            (declare (type simple-string tag)
                     (type fixnum val-sum active))
            (setf (gethash tag by-tag)
                  (the fixnum (+ (the fixnum (gethash tag by-tag 0))
                                 (the fixnum (* val-sum weight)))))
            (incf active-count active)
            (incf total-sum val-sum)))))
    (let ((tag-checksum 0))
      (declare (type fixnum tag-checksum))
      (maphash (lambda (tag total)
                 (declare (type simple-string tag)
                          (type fixnum total))
                 (setf tag-checksum
                       (logand (the fixnum (+ tag-checksum (the fixnum (* (length tag) total))))
                               #x3FFFFFFF)))
               by-tag)
      (list total-sum active-count tag-checksum))))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
