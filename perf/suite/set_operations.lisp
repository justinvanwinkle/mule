;;;; Maintain rotating integer sets with membership probes and set algebra.

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(defparameter *name* "set_operations")
(defparameter *description* "Mutable set updates, membership probes, and binary set algebra")
(defparameter *default-size* 30000)
(defparameter *default-seed* 42)

(defstruct (set-op (:constructor make-set-op (bucket key kind)))
  (bucket 0 :type fixnum)
  (key 0 :type fixnum)
  (kind 0 :type fixnum))

(defun prepare (size seed)
  (declare (type fixnum size seed))
  (when (< size 1)
    (error "size must be positive"))
  (let ((state (logand seed #x7FFFFFFF))
        (ops (make-array size)))
    (declare (type fixnum state)
             (type simple-vector ops))
    (dotimes (i size ops)
      (declare (type fixnum i))
      (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
      (let ((bucket (logand (ash state -4) 7))
            (key (logand (ash state -8) 511))
            (kind (logand (ash state -18) 3)))
        (setf (svref ops i) (make-set-op bucket key kind))))))

(declaim (inline set-add set-discard set-member-p))
(defun set-add (ht key)
  (declare (type hash-table ht)
           (type fixnum key))
  (setf (gethash key ht) t))

(defun set-discard (ht key)
  (declare (type hash-table ht)
           (type fixnum key))
  (remhash key ht))

(defun set-member-p (ht key)
  (declare (type hash-table ht)
           (type fixnum key))
  (nth-value 1 (gethash key ht)))

(defun set-intersection-ht (left right)
  (declare (type hash-table left right))
  (let ((out (make-hash-table :test 'eql)))
    (maphash (lambda (k v)
               (declare (ignore v))
               (when (set-member-p right k)
                 (setf (gethash k out) t)))
             left)
    out))

(defun set-difference-ht (left right)
  (declare (type hash-table left right))
  (let ((out (make-hash-table :test 'eql)))
    (maphash (lambda (k v)
               (declare (ignore v))
               (unless (set-member-p right k)
                 (setf (gethash k out) t)))
             left)
    out))

(defun set-union-ht (left right)
  (declare (type hash-table left right))
  (let ((out (make-hash-table :test 'eql)))
    (maphash (lambda (k v)
               (declare (ignore v))
               (setf (gethash k out) t))
             left)
    (maphash (lambda (k v)
               (declare (ignore v))
               (setf (gethash k out) t))
             right)
    out))

(defun set-symdiff-ht (left right)
  (declare (type hash-table left right))
  (let ((out (make-hash-table :test 'eql)))
    (maphash (lambda (k v)
               (declare (ignore v))
               (unless (set-member-p right k)
                 (setf (gethash k out) t)))
             left)
    (maphash (lambda (k v)
               (declare (ignore v))
               (unless (set-member-p left k)
                 (setf (gethash k out) t)))
             right)
    out))

(defun diff-keep (left right extra)
  (declare (type hash-table left right)
           (type fixnum extra))
  (let ((trimmed (set-difference-ht left right)))
    (set-add trimmed extra)
    trimmed))

(defun run-kernel (data)
  (declare (type simple-vector data))
  (let ((buckets (make-array 8))
        (hits 0)
        (algebra-card 0)
        (n (length data)))
    (declare (type simple-vector buckets)
             (type fixnum hits algebra-card n))
    (dotimes (b 8)
      (declare (type fixnum b))
      (let ((initial (make-hash-table :test 'eql))
            (base (* b 16)))
        (declare (type fixnum base))
        (dotimes (k 16)
          (declare (type fixnum k))
          (set-add initial (+ base k)))
        (setf (svref buckets b) initial)))
    (dotimes (i n)
      (declare (type fixnum i))
      (let* ((op (the set-op (svref data i)))
             (bucket (set-op-bucket op))
             (key (set-op-key op))
             (kind (set-op-kind op))
             (s (the hash-table (svref buckets bucket)))
             (partner (the hash-table (svref buckets (logand (1+ bucket) 7)))))
        (declare (type fixnum bucket key kind))
        (cond
          ((= kind 0)
           (set-add s key)
           (when (set-member-p partner key)
             (incf hits)))
          ((= kind 1)
           (when (set-member-p s key)
             (incf hits))
           (set-discard s key)
           (set-add s (logand (+ key 37) 511)))
          ((= kind 2)
           (let* ((common (set-intersection-ht s partner))
                  (diff (set-difference-ht s partner))
                  (c-len (hash-table-count common))
                  (d-len (hash-table-count diff)))
             (declare (type fixnum c-len d-len))
             (incf algebra-card (+ c-len d-len))
             (when (> c-len 0)
               (set-add s (logand (logxor key c-len) 511)))))
          (t
           (let* ((sym (set-symdiff-ht s partner))
                  (merged (set-union-ht s partner))
                  (sym-len (hash-table-count sym))
                  (m-len (hash-table-count merged)))
             (declare (type fixnum sym-len m-len))
             (incf algebra-card (+ sym-len m-len))
             (when (> (hash-table-count s) 96)
               (setf (svref buckets bucket) (diff-keep s partner key))))))))
    (let ((final-members 0)
          (element-sum 0))
      (declare (type fixnum final-members element-sum))
      (dotimes (b 8)
        (declare (type fixnum b))
        (let ((s (the hash-table (svref buckets b)))
              (weight (1+ b)))
          (declare (type fixnum weight))
          (incf final-members (hash-table-count s))
          (maphash (lambda (val v)
                     (declare (ignore v)
                              (type fixnum val))
                     (incf element-sum (the fixnum (* val weight))))
                   s)))
      (list hits algebra-card final-members element-sum))))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
