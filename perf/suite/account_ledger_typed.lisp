;;;; Simulate a polymorphic account ledger with signed-byte 64 declarations and speed=3, safety=0.

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(declaim (optimize (speed 3) (safety 0) (debug 0)))

(defparameter *name* "account_ledger_typed")
(defparameter *description* "Polymorphic class hierarchy with int64 annotations and speed=3, safety=0")
(defparameter *default-size* 100000)
(defparameter *default-seed* 42)

(defclass account ()
  ((ident :initarg :ident :accessor account-ident :type (signed-byte 64))
   (balance :initarg :balance :accessor account-balance :type (signed-byte 64))
   (tx-count :initform 0 :accessor account-tx-count :type (signed-byte 64))))

(defclass rewards-account (account)
  ((rate :initarg :rate :accessor rewards-account-rate :type (signed-byte 64))
   (points :initform 0 :accessor rewards-account-points :type (signed-byte 64))))

(defclass vault-account (rewards-account)
  ((floor-balance :initarg :floor-balance :accessor vault-account-floor :type (signed-byte 64))
   (penalties :initform 0 :accessor vault-account-penalties :type (signed-byte 64))))

(defgeneric deposit (acc amount))
(defgeneric withdraw (acc amount))
(defgeneric score (acc))

(defmethod deposit ((acc account) amount)
  (declare (optimize (speed 3) (safety 0) (debug 0))
           (type (signed-byte 64) amount))
  (let ((new-bal (the (signed-byte 64) (+ (the (signed-byte 64) (account-balance acc)) amount))))
    (setf (account-balance acc) new-bal)
    (setf (account-tx-count acc) (the (signed-byte 64) (+ (the (signed-byte 64) (account-tx-count acc)) 1)))
    new-bal))

(defmethod withdraw ((acc account) amount)
  (declare (optimize (speed 3) (safety 0) (debug 0))
           (type (signed-byte 64) amount))
  (let* ((cur (the (signed-byte 64) (account-balance acc)))
         (new-bal (if (<= amount cur)
                      (the (signed-byte 64) (- cur amount))
                      (the (signed-byte 64) (- cur 1)))))
    (setf (account-balance acc) new-bal)
    (setf (account-tx-count acc) (the (signed-byte 64) (+ (the (signed-byte 64) (account-tx-count acc)) 1)))
    new-bal))

(defmethod score ((acc account))
  (declare (optimize (speed 3) (safety 0) (debug 0)))
  (the (signed-byte 64)
       (+ (the (signed-byte 64) (* (the (signed-byte 64) (account-balance acc)) 3))
          (the (signed-byte 64) (* (the (signed-byte 64) (account-tx-count acc)) 7))
          (the (signed-byte 64) (account-ident acc)))))

(defmethod deposit ((acc rewards-account) amount)
  (declare (optimize (speed 3) (safety 0) (debug 0))
           (type (signed-byte 64) amount))
  (let* ((bal (the (signed-byte 64) (call-next-method)))
         (pts (the (signed-byte 64)
                   (+ (the (signed-byte 64) (rewards-account-points acc))
                      (the (signed-byte 64) (floor (the (signed-byte 64) (* amount (the (signed-byte 64) (rewards-account-rate acc)))) 10))))))
    (setf (rewards-account-points acc) pts)
    (the (signed-byte 64) (+ bal pts))))

(defmethod score ((acc rewards-account))
  (declare (optimize (speed 3) (safety 0) (debug 0)))
  (the (signed-byte 64)
       (+ (the (signed-byte 64) (call-next-method))
          (the (signed-byte 64) (* (the (signed-byte 64) (rewards-account-points acc)) 5)))))

(defmethod withdraw ((acc vault-account) amount)
  (declare (optimize (speed 3) (safety 0) (debug 0))
           (type (signed-byte 64) amount))
  (if (< (the (signed-byte 64) (- (the (signed-byte 64) (account-balance acc)) amount))
         (the (signed-byte 64) (vault-account-floor acc)))
      (progn
        (setf (vault-account-penalties acc)
              (the (signed-byte 64) (+ (the (signed-byte 64) (vault-account-penalties acc)) 1)))
        (call-next-method acc 1))
      (call-next-method acc amount)))

(defmethod score ((acc vault-account))
  (declare (optimize (speed 3) (safety 0) (debug 0)))
  (the (signed-byte 64)
       (- (the (signed-byte 64) (call-next-method))
          (the (signed-byte 64) (* (the (signed-byte 64) (vault-account-penalties acc)) 11)))))

(defstruct (tx-op (:constructor make-tx-op (idx amount kind)))
  (idx 0 :type (signed-byte 64))
  (amount 0 :type (signed-byte 64))
  (kind 0 :type (signed-byte 64)))

(defun prepare (size seed)
  (declare (optimize (speed 3) (safety 0) (debug 0))
           (type (signed-byte 64) size seed))
  (when (< size 0)
    (error "size must be nonnegative"))
  (let ((state (logand seed #x7FFFFFFF))
        (ops (make-array size)))
    (declare (type (signed-byte 64) state)
             (type simple-vector ops))
    (dotimes (i size ops)
      (declare (type (signed-byte 64) i))
      (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
      (let ((idx (logand (ash state -4) 63))
            (amount (+ (mod (ash state -10) 97) 1))
            (kind (logand state 3)))
        (setf (svref ops i) (make-tx-op idx amount kind))))))

(defun run-kernel (data)
  (declare (optimize (speed 3) (safety 0) (debug 0))
           (type simple-vector data))
  (let ((accounts (make-array 64)))
    (declare (type simple-vector accounts))
    (dotimes (i 64)
      (declare (type (signed-byte 64) i))
      (let ((kind (mod i 3))
            (initial (+ 500 (* i 10))))
        (setf (svref accounts i)
              (cond
                ((= kind 0)
                 (make-instance 'account :ident i :balance initial))
                ((= kind 1)
                 (make-instance 'rewards-account :ident i :balance initial :rate (+ (mod i 5) 1)))
                (t
                 (make-instance 'vault-account :ident i :balance initial :rate (+ (mod i 4) 1) :floor-balance 200))))))
    (let* ((n (length data))
           (rounds (max 1 (floor n 425)))
           (rolling 0))
      (declare (type (signed-byte 64) n rounds rolling))
      (dotimes (round-idx rounds)
        (declare (type (signed-byte 64) round-idx))
        (let ((bonus (logand round-idx 7)))
          (declare (type (signed-byte 64) bonus))
          (dotimes (j n)
            (declare (type (signed-byte 64) j))
            (let* ((op (the tx-op (svref data j)))
                   (idx (tx-op-idx op))
                   (amount (tx-op-amount op))
                   (kind (tx-op-kind op))
                   (acc (svref accounts (logand (+ idx round-idx) 63)))
                   (adj (the (signed-byte 64) (+ amount bonus))))
              (declare (type (signed-byte 64) idx amount kind adj))
              (cond
                ((= kind 0)
                 (setf rolling (logand (+ rolling (the (signed-byte 64) (deposit acc adj))) #x3FFFFFFF)))
                ((= kind 1)
                 (setf rolling (logand (+ rolling (the (signed-byte 64) (withdraw acc adj))) #x3FFFFFFF)))
                (t
                 (setf rolling (logand (+ rolling (the (signed-byte 64) (score acc)) ) #x3FFFFFFF))))))))
      (let ((final-score 0)
            (tx-total 0))
        (declare (type (signed-byte 64) final-score tx-total))
        (dotimes (i 64)
          (declare (type (signed-byte 64) i))
          (let ((acc (svref accounts i)))
            (incf final-score (the (signed-byte 64) (score acc)))
            (incf tx-total (the (signed-byte 64) (account-tx-count acc)))))
        (list rolling final-score tx-total)))))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
