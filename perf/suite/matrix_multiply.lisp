;;;; Multiply dense integer matrices and reduce diagonal and Frobenius norms.

(eval-when (:compile-toplevel :load-toplevel :execute)
  (load #.(merge-pathnames "perfutils/case.lisp"
                           (or *compile-file-truename* *load-truename*))
        :verbose nil :print nil))

(defparameter *name* "matrix_multiply")
(defparameter *description* "Dense 2D matrix multiplication and norm reduction")
(defparameter *default-size* 490)
(defparameter *default-seed* 42)

(defun prepare (size seed)
  (when (< size 1)
    (error "size must be positive"))
  (let ((state (logand seed #x7FFFFFFF))
        (left (make-array size))
        (right (make-array size)))
    (dotimes (i size (cons left right))
      (let ((row-a (make-array size))
            (row-b (make-array size)))
        (dotimes (j size)
          (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
          (setf (svref row-a j) (- (mod (ash state -8) 61) 30))
          (setf state (logand (+ (* state 1103515245) 12345) #x7FFFFFFF))
          (setf (svref row-b j) (- (mod (ash state -8) 61) 30)))
        (setf (svref left i) row-a
              (svref right i) row-b)))))

(defun run-kernel (data)
  (let* ((left (car data))
         (right (cdr data))
         (n (length left))
         (transposed (make-array n)))
    (dotimes (col n)
      (let ((t-row (make-array n)))
        (dotimes (row n)
          (setf (svref t-row row)
                (svref (svref right row) col)))
        (setf (svref transposed col) t-row)))
    (let ((trace 0)
          (frobenius 0))
      (dotimes (i n)
        (let ((row-a (svref left i)))
          (dotimes (j n)
            (let ((col-b (svref transposed j))
                  (acc 0))
              (dotimes (k n)
                (incf acc (* (svref row-a k)
                             (svref col-b k))))
              (when (= i j)
                (incf trace acc))
              (setf frobenius
                    (logand (+ frobenius (* acc acc))
                            #x3FFFFFFF))))))
      (list trace frobenius))))

(defun main ()
  (run-case *name* *description* *default-size* *default-seed* #'prepare #'run-kernel))

(eval-when (:execute)
  (main))
