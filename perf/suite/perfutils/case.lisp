;;;; The common CLI and timing protocol used by each standalone SBCL scenario.

(declaim (optimize (speed 3) (safety 1) (debug 1)))

(defun monotonic-seconds ()
  (multiple-value-bind (sec nsec)
      (sb-unix:clock-gettime sb-unix:clock-monotonic)
    (+ ( coerce sec 'double-float)
       (* (coerce nsec 'double-float) 1.0d-9))))

(defun fail-cli (message)
  (format *error-output* "ValueError: ~A~%" message)
  (finish-output *error-output*)
  (sb-ext:exit :code 1))

(defun parse-strict-integer (text)
  (handler-case
      (multiple-value-bind (value end) (parse-integer text :junk-allowed nil)
        (if (= end (length text))
            value
            (fail-cli (format nil "invalid integer: ~A" text))))
    (error ()
      (fail-cli (format nil "invalid integer: ~A" text)))))

(defun format-result-tuple (result)
  (cond
    ((null result) "()")
    ((null (cdr result)) (format nil "(~D,)" (car result)))
    (t (format nil "(~{~D~^, ~})" result))))

(defun format-float-seconds (seconds)
  (let ((*read-default-float-format* 'double-float))
    (princ-to-string (coerce seconds 'double-float))))

(defun run-case (name description default-size default-seed prepare kernel)
  "Prepare once, time calls, and consume every result outside the timer."
  (sb-ext:disable-debugger)
  (let ((size-str (write-to-string default-size))
        (seed-str (write-to-string default-seed))
        (loops-str "1")
        (warmups-str "1")
        (arguments (cdr sb-ext:*posix-argv*)))
    (when (and (= (length arguments) 1)
               (string= (first arguments) "--help"))
      (format t "~A: ~A~%" name description)
      (format t "--size N --seed N --loops N --warmups N~%")
      (finish-output)
      (return-from run-case nil))
    (when (oddp (length arguments))
      (fail-cli "options require a value; use --help for usage"))
    (loop for (option value) on arguments by #'cddr do
      (cond
        ((string= option "--size") (setf size-str value))
        ((string= option "--seed") (setf seed-str value))
        ((string= option "--loops") (setf loops-str value))
        ((string= option "--warmups") (setf warmups-str value))
        (t (fail-cli (format nil "unknown option: ~A" option)))))
    (let ((size (parse-strict-integer size-str))
          (seed (parse-strict-integer seed-str))
          (loops (parse-strict-integer loops-str))
          (warmups (parse-strict-integer warmups-str)))
      (when (or (< size 1) (< loops 1) (< warmups 0))
        (fail-cli "size and loops must be positive; warmups must be nonnegative"))
      (let* ((prep-start (monotonic-seconds))
             (data (funcall prepare size seed))
             (preparation (- (monotonic-seconds) prep-start))
             (expected nil)
             (has-expected nil)
             (elapsed 0.0d0))
        (dotimes (i warmups)
          (let ((result (funcall kernel data)))
            (when (and has-expected (not (equal result expected)))
              (error "unstable warmup result"))
            (setf expected result
                  has-expected t)))
        (dotimes (i loops)
          (let* ((started (monotonic-seconds))
                 (result (funcall kernel data)))
            (incf elapsed (- (monotonic-seconds) started))
            (when (and has-expected (not (equal result expected)))
              (error "kernel changed its input or returned unstable results"))
            (setf expected result
                  has-expected t)))
        (format t "CASE~C~A~%" #\Tab name)
        (format t "SIZE~C~D~%" #\Tab size)
        (format t "SEED~C~D~%" #\Tab seed)
        (format t "LOOPS~C~D~%" #\Tab loops)
        (format t "RESULT~C~A~%" #\Tab (format-result-tuple expected))
        (format t "PREPARE~C~A~%" #\Tab (format-float-seconds preparation))
        (format t "KERNEL~C~A~%" #\Tab (format-float-seconds (/ elapsed loops)))
        (finish-output)))))
